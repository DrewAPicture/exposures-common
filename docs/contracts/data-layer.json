{
  "contract": "exposures-data-layer",
  "description": "Wear Data Layer contract shared by exposures-phone and exposures-watch. Regenerated from DataLayerPaths and kotlinx.serialization descriptors. Update with ./gradlew :core-datalayer:testDebugUnitTest -PupdateContractSpec",
  "encoding": {
    "format": "json",
    "ignoreUnknownKeys": true,
    "encodeDefaults": false
  },
  "compatibility": {
    "policy": "docs/CONTRACT_COMPATIBILITY.md",
    "evolution": "additive-by-default",
    "breaking": "field removal/rename/type-change is a major version with coordinated phone+watch rollout",
    "enumAdditions": "allowed only when every consumer handles unknown values without unchecked valueOf"
  },
  "paths": {
    "CAMERA_BODIES": {
      "value": "/equipment/camera-bodies",
      "kind": "dataItem",
      "writer": "phone",
      "reader": "watch",
      "payload": {
        "$ref": "CameraBodyDto",
        "cardinality": "array"
      }
    },
    "CAPABILITY_EXPOSURES_APP": {
      "value": "exposures_app",
      "kind": "capability",
      "notes": "both apps advertise this so each side can find the other's connected node"
    },
    "CAPTURE_PHOTO_COMMAND": {
      "value": "/command/capture-photo",
      "kind": "command",
      "writer": "watch",
      "reader": "phone",
      "payload": {
        "$ref": "CapturePhotoCommand",
        "cardinality": "object"
      }
    },
    "CAPTURE_RESULT_COMMAND": {
      "value": "/command/capture-result",
      "kind": "command",
      "writer": "phone",
      "reader": "watch",
      "payload": {
        "$ref": "CaptureResultCommand",
        "cardinality": "object"
      }
    },
    "COMPLETE_ROLL_COMMAND": {
      "value": "/command/complete-roll",
      "kind": "command",
      "writer": "watch",
      "reader": "phone",
      "payload": {
        "$ref": "CompleteRollCommand",
        "cardinality": "object"
      }
    },
    "CONNECTIVITY_PING_ACK_COMMAND": {
      "value": "/command/connectivity-ping-ack",
      "kind": "command",
      "writer": "phone",
      "reader": "watch",
      "notes": "empty payload"
    },
    "CONNECTIVITY_PING_COMMAND": {
      "value": "/command/connectivity-ping",
      "kind": "command",
      "writer": "watch",
      "reader": "phone",
      "notes": "empty payload"
    },
    "CREATE_EXPOSURE_ACK_COMMAND": {
      "value": "/command/create-exposure-ack",
      "kind": "command",
      "writer": "watch",
      "reader": "phone",
      "payload": {
        "$ref": "CreateExposureAckCommand",
        "cardinality": "object"
      }
    },
    "CREATE_EXPOSURE_COMMAND": {
      "value": "/command/create-exposure",
      "kind": "command",
      "writer": "phone",
      "reader": "watch",
      "payload": {
        "$ref": "CreateExposureCommand",
        "cardinality": "object"
      }
    },
    "EXPOSURES": {
      "value": "/exposures",
      "kind": "dataItem",
      "writer": "watch",
      "reader": "phone",
      "payload": {
        "$ref": "ExposureDto",
        "cardinality": "array"
      }
    },
    "FILM_BACKS": {
      "value": "/equipment/film-backs",
      "kind": "dataItem",
      "writer": "phone",
      "reader": "watch",
      "payload": {
        "$ref": "FilmBackDto",
        "cardinality": "array"
      }
    },
    "KEY_PAYLOAD": {
      "value": "payload",
      "kind": "payloadKey",
      "notes": "DataMap key for the JSON payload; DataMap also carries an updatedAt timestamp that is not part of the JSON contract"
    },
    "LENSES": {
      "value": "/equipment/lenses",
      "kind": "dataItem",
      "writer": "phone",
      "reader": "watch",
      "payload": {
        "$ref": "LensDto",
        "cardinality": "array"
      }
    },
    "LIGHT_METERS": {
      "value": "/equipment/light-meters",
      "kind": "dataItem",
      "writer": "phone",
      "reader": "watch",
      "payload": {
        "$ref": "LightMeterDto",
        "cardinality": "array"
      }
    },
    "PHOTO_STATUSES": {
      "value": "/photo-status",
      "kind": "dataItem",
      "writer": "phone",
      "reader": "watch",
      "payload": {
        "$ref": "PhotoStatusDto",
        "cardinality": "array"
      }
    },
    "REQUEST_ROLLS_SYNC_COMMAND": {
      "value": "/command/request-rolls-sync",
      "kind": "command",
      "writer": "watch",
      "reader": "phone",
      "notes": "empty payload; phone responds by pushing current equipment/roll DataItems"
    },
    "ROLLS": {
      "value": "/rolls",
      "kind": "dataItem",
      "writer": "phone",
      "reader": "watch",
      "payload": {
        "$ref": "FilmRollDto",
        "cardinality": "array"
      }
    }
  },
